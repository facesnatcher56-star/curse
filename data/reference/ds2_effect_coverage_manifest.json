      "notes": "Supported for fixed discipline level requirements."
    },
    "alternative_or": {
      "status": "unsupported",
      "syntax": "<clause>|<clause>",
      "occurrences": 79,
      "examples": [
        "combat magic:#item_level-8.0|nature magic:#item_level-8.0",
        "combat magic:#item_level-2.0|nature magic:#item_level-2.0",
